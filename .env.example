# Copy this file to .env (gitignored) and fill in real values.
# Never commit .env or put API keys in this example.

# Primary AI Studio key (powers both Gemini 2.5 Flash statblocks and Imagen portraits)
GEMINI_API_KEY=

# Optional model overrides (defaults: Gemini 2.5 Flash for statblocks, Imagen 4/3 for portraits)
# GEMINI_STATBLOCK_MODEL=gemini-2.5-flash
# IMAGEN_MODEL=imagen-3.0-generate-002

# Optional Fallbacks
OPENROUTER_API_KEY=
POLLINATIONS_API_KEY=
HF_TOKEN=

# App Security & Deployment
GENERATION_PASSPHRASE=
CORS_ORIGIN=https://YOURUSER.github.io
DAILY_LIMIT=20
PORT=8080
