# Copy this file to .env (gitignored) and fill in real values.
# Never commit .env or put API keys in this example.

# Primary AI Studio key (powers Gemini Flash statblocks and Gemini/Imagen portraits).
# Portraits need billing enabled on the key's project: free tier has 0 image quota.
GEMINI_API_KEY=

# Optional model overrides. Statblocks try the newest Gemini Flash first (3.8 down to 3.5).
# Pro models reason best but are paid-tier only; free keys get 429 from them.
# GEMINI_STATBLOCK_MODEL=gemini-3.1-pro-preview
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Free portrait fallback: Cloudflare Workers AI (10,000 neurons/day free, ~120 FLUX portraits).
# Account ID is in the dashboard sidebar; create the token from the "Workers AI" API token template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Optional Fallbacks
OPENROUTER_API_KEY=
# Secret sk_ key from https://enter.pollinations.ai/keys (unset = anonymous legacy endpoint)
POLLINATIONS_API_KEY=

# App Security & Deployment
GENERATION_PASSPHRASE=
CORS_ORIGIN=https://YOURUSER.github.io
DAILY_LIMIT=20
PORT=8080
